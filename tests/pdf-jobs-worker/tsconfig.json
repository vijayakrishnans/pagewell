{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node",
      "@cloudflare/workers-types"
    ],
    "allowSyntheticDefaultImports": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@saas/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@saas/contracts/*": [
        "../../packages/contracts/src/*.ts"
      ],
      "@saas/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@saas/shared/*": [
        "../../packages/shared/src/*.ts"
      ],
      "@saas/policy-engine": [
        "../../packages/policy-engine/src/index.ts"
      ],
      "@saas/db": [
        "../../packages/db/src/index.ts"
      ],
      "@saas/db/*": [
        "../../packages/db/src/*/index.ts"
      ],
      "@files-worker/*": [
        "../../apps/files-worker/src/*.ts"
      ],
      "@jobs-worker/*": [
        "../../apps/pdf-jobs-worker/src/*.ts"
      ],
      "@saas/notifications-client": [
        "../../packages/notifications-client/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../files-worker/src/harness.ts",
    "../../apps/files-worker/src/**/*.ts",
    "../../apps/pdf-jobs-worker/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
