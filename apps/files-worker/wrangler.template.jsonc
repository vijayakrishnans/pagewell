// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
//
// files-worker: Pagewell's drive. D1 for rows, R2 (pagewell-files-<env>, never
// public) for the bytes. No public route: api-edge reaches it by service binding.
{
  "name": "pagewell-files-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        // Where a share invitation's "Open" button goes (the console's Shared with me).
        "CONSOLE_URL": "https://pagewell-web-console-next-stage.vijayakrishnan12994.workers.dev"
      },
      "triggers": { "crons": ["17 3 * * *"] },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "pagewell-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "@@wiring(cloudflare-r2/stage:r2_bucket_name)@@"
        }
      ],
      "services": [
        { "binding": "MEMBERSHIP_WORKER", "service": "pagewell-membership-worker-stage" },
        { "binding": "POLICY_WORKER", "service": "pagewell-policy-worker-stage" },
        { "binding": "BILLING_WORKER", "service": "pagewell-billing-worker-stage" },
        { "binding": "NOTIFICATIONS_WORKER", "service": "pagewell-notifications-worker-stage" }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        // Where a share invitation's "Open" button goes (the console's Shared with me).
        "CONSOLE_URL": "https://pagewell-web-console-next-prod.vijayakrishnan12994.workers.dev"
      },
      "triggers": { "crons": ["17 3 * * *"] },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "pagewell-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "@@wiring(cloudflare-r2/prod:r2_bucket_name)@@"
        }
      ],
      "services": [
        { "binding": "MEMBERSHIP_WORKER", "service": "pagewell-membership-worker-prod" },
        { "binding": "POLICY_WORKER", "service": "pagewell-policy-worker-prod" },
        { "binding": "BILLING_WORKER", "service": "pagewell-billing-worker-prod" },
        { "binding": "NOTIFICATIONS_WORKER", "service": "pagewell-notifications-worker-prod" }
      ]
    }
  }
}
